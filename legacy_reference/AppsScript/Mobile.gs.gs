function userBulkPartition_(rows,db,u){rows=rows.slice();const rejected=[],fixFor=m=>/Region belum dipetakan/.test(m)?'Tambah region di Admin › Master › Region Map, atau ganti REGION ke region yang ada (bukan Big Region).':/NIK tidak valid/.test(m)?'NIK hanya huruf/angka/titik/strip (2–60 karakter) dan tidak boleh dobel di file.':/Nama\/jabatan/.test(m)?'Isi NAMA, dan JABATAN/POSISI: SALES, ASM, RGM'+(u.role==='SUPER ADMIN'?', ADMIN, HEAD OF SALES, dst.':'.'):/luar penugasan/.test(m)?'Region ini di luar wilayah tugas Anda — minta Super Admin.':/Wilayah Admin/.test(m)?'Isi WILAYAH ADMIN dengan Big Region yang ada, pisahkan dengan |.':/atasan wajib/.test(m)?'Isi NIK ATASAN (ASM untuk Sales, RGM untuk ASM).':/Atasan tidak valid/.test(m)?'NIK ATASAN harus terdaftar (atau ada di file yang sama) dan jabatannya lebih tinggi.':'Perbaiki baris ini lalu upload ulang.';
