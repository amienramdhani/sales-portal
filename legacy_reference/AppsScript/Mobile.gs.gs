 if(u.role==='SUPER ADMIN'||u.role==='RGM'||RegionCore.top(u.role))return true;
 const ids=PortalCore.scope(db.meta.people,u.nik);
 if(u.role==='ADMIN')return ids.includes(p.nik);
 if(u.role==='ASM')return p.role==='ASM'||ids.includes(p.nik);
 if(u.role==='SALES'){const me=db.meta.people.find(x=>x.nik===u.nik);return p.role==='SALES'&&(p.nik===u.nik||!!me?.atasan&&me.atasan===p.atasan&&db.meta.people.some(x=>x.nik===me.atasan&&x.role==='ASM'));}
 return false;
}
