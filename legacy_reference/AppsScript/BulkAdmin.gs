function bulkReadRows_(file,preferred){if(!file?.getBytes||!file.getBytes().length||file.getBytes().length>8*1024*1024)throw Error('Pilih XLSX/CSV maksimal 8 MB.');let grid,tmp;try{if(/\.csv$/i.test(file.getName())){const text=file.getDataAsString('UTF-8').replace(/^\uFEFF/,'');const first=text.split(/\r?\n/)[0]||'';grid=Utilities.parseCsv(text,first.split(';').length>first.split(',').length?';':',');}else if(/\.xlsx$/i.test(file.getName())){tmp=Drive.Files.create({name:'BULK_IMPORT',mimeType:'application/vnd.google-apps.spreadsheet',parents:[folder_().getId()]},file,{fields:'id'}).id;const wb=SpreadsheetApp.openById(tmp),sh=(preferred&&wb.getSheetByName(preferred))||wb.getSheets()[0];grid=sh.getDataRange().getDisplayValues();}else throw Error('Gunakan XLSX atau CSV.');const heads=(grid.shift()||[]).map(PortalCore.text);if(!heads.length)throw Error('Header file kosong.');return {heads,rows:grid.filter(r=>r.some(v=>PortalCore.text(v))).map(r=>Object.fromEntries(heads.map((h,i)=>[h,r[i]])))};}finally{if(tmp)DriveApp.getFileById(tmp).setTrashed(true);}}
