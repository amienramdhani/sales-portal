function transferRows_(rows,db,u){if(!rows.length||rows.length>5000)throw Error('Isi 1–5.000 dealer per transfer.');const seen=new Set(),today=Utilities.formatDate(new Date(),'Asia/Jakarta','yyyy-MM-dd');return rows.map((r,i)=>{const dealer=PortalCore.text(r['KODE CUSTOMER']),nik=PortalCore.text(r.NEW_SALES_NIK),date=PortalCore.iso(r.EFFECTIVE_DATE),note=PortalCore.text(r.NOTE),c=db.meta.customers[dealer],p=db.meta.people.find(x=>x.nik===nik);if(!dealer||!c)throw Error('Baris '+(i+2)+': dealer tidak ditemukan: '+dealer);if(seen.has(dealer))throw Error('Baris '+(i+2)+': dealer duplikat dalam file: '+dealer);seen.add(dealer);if(!p?.sales||!canManageUser_(u,p))throw Error('Baris '+(i+2)+': Sales tujuan tidak valid/di luar kewenangan: '+nik);const oldNik=PortalCore.text(c.nik);const oldP=db.meta.people.find(x=>x.nik===oldNik);if(u.role!=='SUPER ADMIN'&&oldP&&!canManageUser_(u,oldP))throw Error('Baris '+(i+2)+': dealer sumber di luar kewenangan.');if(oldNik===nik)throw Error('Baris '+(i+2)+': Sales tujuan sama dengan owner saat ini.');if(date>today)throw Error('Baris '+(i+2)+': tanggal efektif masa depan belum didukung; jalankan transfer pada/ setelah tanggal efektif.');const oldBig=PortalCore.text(RegionCore.route(db,{customer:dealer,date,nik:oldNik},'ST')),newBig=PortalCore.text(p.wilayah);return {dealer,nama:c.nama||dealer,oldNik,oldName:oldP?.nama||oldNik,newNik:nik,newName:p.nama,date,note,oldBig,newBig,cross:!!(newBig&&oldBig&&newBig.toUpperCase()!==oldBig.toUpperCase()),regionFrom:(()=>{const m=dealerRegionMin_(db);return m&&date<m?m:date;})()};});}
