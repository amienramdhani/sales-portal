function monthSequence_(from,to){const out=[];for(let d=from+'-01';d<=to+'-01';d=StockCore.shift(PortalCore.end(d.slice(0,7)),1))out.push(d.slice(0,7));return out;}
function summarySO_(rows){return {rows:rows.length,qty:rows.reduce((n,r)=>n+r.qty,0),amount:PortalCore.round(rows.reduce((n,r)=>n+(r.amount||0),0))};}
