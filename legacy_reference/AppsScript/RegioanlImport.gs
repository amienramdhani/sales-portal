function coverageView_(db,period,ids,kind,actor){
 const selected=RegionCore.sliceFor(db,period,ids,kind).filter(r=>actor?.role!=='ADMIN'||(actor.adminRegions||[]).includes(r));
 const view={...db,coverage:{},stock:db.stock?{...db.stock,coverage:{},moves:db.stock.moves.filter(t=>!t.region||selected.includes(t.region))}:null,cubes:{}};if(!db.parts)return db;
