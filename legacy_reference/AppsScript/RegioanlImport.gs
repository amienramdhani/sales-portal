 const months=history?[...new Set(rows.map(t=>t.date.slice(0,7)).concat(monthSequence_(StockCore.BASE.slice(0,7),period)))]:[period];months.forEach(p=>assertPeriodOpen_(p));if(history&&regions.some(r=>Object.values(old.parts.SO||{}).some(m=>m[r])))throw Error('Histori SO region ini sudah ada. Gunakan penggantian bulanan.');
