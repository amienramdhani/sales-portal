 }
 if(!view.coverage[period]){view.coverage[period]={cutoff:period+'-01',closed:false};view.noData=true;view.missingST=true;view.partial=true;view.regionStatus=selected.map(r=>({region:r,st:null,so:db.parts.SO?.[period]?.[r]?.cutoff||null}));}view.selectedRegions=selected;view.historyComplete=monthSequence_(StockCore.BASE.slice(0,7),period).every(p=>{const c=RegionCore.common(db.parts,'ST',p,selected);return c.cutoff&&c.cutoff>=(p===period?view.coverage[p]?.cutoff:PortalCore.end(p));});return view;
}
