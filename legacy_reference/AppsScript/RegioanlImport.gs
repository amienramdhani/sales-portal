function stReadFile_(file){
 if(!file?.getBytes||file.getBytes().length>5*1024*1024)throw Error('Pilih XLSX/CSV maksimal 5 MB.');let data,tmp;try{const name=file.getName();if(/\.csv$/i.test(name)){const s=file.getDataAsString('UTF-8').replace(/^\uFEFF/,''),line=s.split(/\r?\n/)[0];data=Utilities.parseCsv(s,line.split(';').length>line.split(',').length?';':',');}else if(/\.xlsx$/i.test(name)){tmp=Drive.Files.create({name:'ST_IMPORT',mimeType:'application/vnd.google-apps.spreadsheet',parents:[folder_().getId()]},file,{fields:'id'}).id;const w=SpreadsheetApp.openById(tmp);w.setSpreadsheetTimeZone('Asia/Jakarta');const sh=w.getSheetByName('Master_Transaksi')||(w.getSheets().length===1?w.getSheets()[0]:null);if(!sh)throw Error('Sheet Master_Transaksi tidak ditemukan.');data=sh.getDataRange().getValues();}else throw Error('Format XLSX atau CSV.');const heads=data.shift().map(PortalCore.text);['TANGGAL TRANSAKSI','NO TRANSAKSI','KODE PRODUK','KODE CUSTOMER','NIK SALES','QTY','AMOUNT'].forEach(k=>{if(!heads.includes(k))throw Error('Kolom wajib '+k);});return data.filter(r=>r.some(v=>v!==''&&v!=null)).map(r=>Object.fromEntries(heads.map((k,i)=>[k,r[i] instanceof Date?Utilities.formatDate(r[i],'Asia/Jakarta','yyyy-MM-dd'):r[i]])));}finally{if(tmp)DriveApp.getFileById(tmp).setTrashed(true);}}
function parseRegions_(value,meta){let list;try{list=JSON.parse(String(value||'[]'));}catch(e){throw Error('Pilihan region tidak valid.');}const known=RegionCore.regions(meta);if(!Array.isArray(list)||!list.length||list.some(r=>typeof r!=='string'||!known.includes(r)))throw Error('Pilih big region yang sah.');return [...new Set(list)];}
