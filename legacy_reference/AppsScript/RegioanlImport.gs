 const rm=kind==='ST'?stRemapNik_(objects,meta):{count:0,note:''};
 const rows=kind==='ST'?PortalCore.transactions(objects,meta,period,cutoff):StockCore.parse(objects,meta,history?null:period,cutoff),routing=RegionCore.routing(meta,Object.keys(old.raw).flatMap(p=>readJson_(old.raw[p])),old.routing),shell={meta,routing};if(rows.length>150000)throw Error('Maksimal 150.000 baris per impor.');const by={},warnings=[];if(rm.count)warnings.push(rm.note);
 rows.forEach((t,i)=>{const region=RegionCore.route(shell,t,kind),brand=importBrand_(t,meta,kind);if(!region||!regions.includes(region))throw Error('Baris '+(i+2)+': dealer '+t.customer+' masuk '+(region||'region belum terpetakan')+', di luar pilihan.');if(brands.length&&!brands.includes(brand))throw Error('Baris '+(i+2)+': brand '+(brand||'tidak dikenal')+' di luar brand upload '+brands.join(', ')+'.');t.region=region;(by[region]||(by[region]=[])).push(t);});
