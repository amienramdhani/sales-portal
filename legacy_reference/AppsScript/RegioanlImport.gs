function importBrand_(t,meta,kind){return PortalCore.text(t.brand)||PortalCore.text(meta.products?.[t.sku]?.brand);}
function stageRegionImport_(form,kind){const u=adminGuard_(form.token),old=snapshot_(),meta=meta_();if(!old.parts)throw Error('Jalankan Upgrade v4 terlebih dahulu.');const regions=parseRegions_(form.regions,meta),brands=parseImportBrands_(form.brands,meta),period=PortalCore.month(form.period),cutoff=PortalCore.iso(form.cutoff),history=kind==='SO'&&form.mode==='HISTORY';if(cutoff.slice(0,7)!==period)throw Error('Cutoff berbeda bulan.');assertPeriodOpen_(period);if(history&&cutoff<StockCore.BASE)throw Error('Histori awal minimal Desember 2025.');if(history&&brands.length)throw Error('Mode histori awal SO harus menggunakan Semua Brand.');
