func Text(v any) string {
	if v == nil {
		return ""
	}
	return strings.TrimSpace(fmt.Sprint(v))
}
func Active(v any) bool {
	s := strings.ToUpper(Text(v))
	return v == true || s == "TRUE" || s == "YA" || s == "1"
}

// RoundJS2 follows the existing PortalCore.round contract closely: Math.round((n+EPSILON)*100)/100.
func RoundJS2(n float64) float64 {
	x := (n + math.Nextafter(1, 2) - 1) * 100
	// JavaScript Math.round is floor(x+0.5), including negative half values.
	return math.Floor(x+0.5) / 100
}

