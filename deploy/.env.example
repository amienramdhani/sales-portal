APP_ENV=production
HTTP_ADDR=:8080
APP_TIMEZONE=Asia/Jakarta
DOMAIN=sales.example.co.id
PUBLIC_BASE_URL=https://sales.example.co.id

POSTGRES_DB=salesportal
POSTGRES_USER=salesportal
POSTGRES_PASSWORD=GANTI_PASSWORD_PANJANG
DATABASE_URL=postgres://salesportal:GANTI_PASSWORD_PANJANG@db:5432/salesportal?sslmode=disable

# WAJIB sama dengan Script Properties PEPPER di Apps Script selama masa paralel.
AUTH_PEPPER=GANTI_DENGAN_PEPPER_LAMA
SESSION_COOKIE_NAME=sp_session
SESSION_TTL=12h
PARALLEL_MODE=true

# Folder 2. SELESAI pada Google Drive. Service account hanya diberi Viewer ke folder ini.
DRIVE_FINISHED_FOLDER_ID=GANTI_FOLDER_ID
GOOGLE_APPLICATION_CREDENTIALS=/run/secrets/google-service-account.json
DRIVE_POLL_INTERVAL=15m

BACKUP_DIR=/var/lib/salesportal/backups
BACKUP_RETENTION_DAYS=30
SLOW_QUERY_THRESHOLD=500ms
LOG_LEVEL=info

# AI opsional. Kosongkan kalau belum diputuskan.
AI_BASE_URL=
AI_API_KEY=
AI_MODEL=
